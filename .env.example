# Added automatically when the Neon resource is connected to Vercel.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Court access. Use different four-digit values in production.
COURT_1_PIN="1111"
COURT_2_PIN="2222"
COURT_3_PIN="3333"
COURT_4_PIN="4444"
ADMIN_PIN="9999"

# Generate a random value of at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-secret-value"
